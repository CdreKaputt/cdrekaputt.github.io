---
import Hero from "../components/Hero.astro";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

import type Post from "../types/post";

import { getRecentPosts } from "../lib/posts.ts";

const posts: Post[] = await getRecentPosts(6);
---

<BaseLayout title="Home">
  <Hero slot="hero" title="Hello">
    <p>A short intro line under the heading.</p>
  </Hero>
  <section class="flex flex-col gap-12">
    <div class="max-w-[60ch]">
      <h2 class="text-3xl">Recent Updates</h2>
      <p>
        Lorem ipsum dolor sit amet consectetur adipisicing elit. Ipsam dolorem
        autem quidem nemo rerum maxime? Soluta, dolor. Natus eveniet, molestias
        commodi, iste, obcaecati dolorum repellat temporibus ab sint illo
        tempora?
      </p>
    </div>
    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
      {
        posts.map((post) => (
          <li>
            <PostCard {...post} />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
