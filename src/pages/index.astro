---
import Hero from "../components/Hero.astro";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

import type Post from "../types/post";

import { getRecentPosts } from "../lib/posts.ts";

const posts: Post[] = await getRecentPosts(6);
---

<BaseLayout title="Home">
  <Hero
    slot="hero"
    title="Aaron Brunswig"
    subtitle="Web developer · CS student at CU Boulder"
  >
    <p>
      I build websites and web apps, and I'm studying computer science to go
      deeper into backend systems. This site documents my course project.
    </p>

    <Fragment slot="actions">
      <a
        href="/about"
        class="rounded-md bg-on-inverse px-5 py-2 5 text-sm font-semibold text-ink hover:bg-on-inverse-muted"
      >
        About me
      </a>
      <a
        href="#contact"
        class="rounded-md border border-on-inverse-muted/50 px-5 py-2 5 text-sm font-semibold text-on-inverse hover:border-on-inverse-muted"
      >
        Contact
      </a>
    </Fragment>
  </Hero>
  <section class="flex flex-col gap-12">
    <div class="max-w-[60ch]">
      <h2 class="text-3xl">Recent Updates</h2>
      <p>
        Lorem ipsum dolor sit amet consectetur adipisicing elit. Ipsam dolorem
        autem quidem nemo rerum maxime? Soluta, dolor. Natus eveniet, molestias
        commodi, iste, obcaecati dolorum repellat temporibus ab sint illo
        tempora?
      </p>
    </div>
    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
      {
        posts.map((post) => (
          <li>
            <PostCard {...post} />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
