---
import Hero from "../components/Hero.astro";
import PostCard from "../components/PostCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

import type Author from "../types/author";
import type Post from "../types/post";
import type Tag from "../types/tag";
import portrait from "../assets/aaron-headshot-v-2.jpg";

const aaron: Author = { name: "Aaron Brunswig", avatar: portrait };
const week1: Tag = { label: "Week 1", url: "/blog/week-1" };
const setup: Tag = { label: "Setup", url: "/tags/setup" };
const build: Tag = { label: "Build", url: "/blog/build" };
const deploy: Tag = { label: "Deploy", url: "/blog/deploy" };
const test: Tag = { label: "Test", url: "/blog/test" };

const posts: Post[] = [
  {
    title: "Week 1 - Getting Started",
    excerpt:
      "This week I reviewed the course requirements, took a look at the previous student examples that were provided...",
    date: new Date(2026, 8, 10),
    href: "/blog/week-1/getting-started",
    author: aaron,
    category: week1,
    tags: [build, deploy, test],
  },
  {
    title: "Week 1 - Getting Started",
    excerpt:
      "This week I reviewed the course requirements, took a look at the previous student examples that were provided...",
    date: new Date(2026, 8, 10),
    href: "/blog/week-1/getting-started",
    author: aaron,
    category: week1,
    tags: [setup],
  },
  {
    title: "Week 1 - Getting Started",
    excerpt:
      "This week I reviewed the course requirements, took a look at the previous student examples that were provided...",
    date: new Date(2026, 8, 10),
    href: "/blog/week-1/getting-started",
    author: aaron,
    category: week1,
    tags: [setup],
  },
];
---

<BaseLayout title="Home">
  <Hero slot="hero" title="Hello">
    <p>A short intro line under the heading.</p>
  </Hero>
  <section class="flex flex-col gap-12">
    <div class="max-w-[60ch]">
      <h2 class="text-3xl">Recent Updates</h2>
      <p>
        Lorem ipsum dolor sit amet consectetur adipisicing elit. Ipsam dolorem
        autem quidem nemo rerum maxime? Soluta, dolor. Natus eveniet, molestias
        commodi, iste, obcaecati dolorum repellat temporibus ab sint illo
        tempora?
      </p>
    </div>
    <ul class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 items-stretch">
      {
        posts.map((post) => (
          <li>
            <PostCard {...post} />
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
