---
import Hero from "../components/Hero.astro";
import PostCard from "../components/PostCard.astro";
import SkillGroups from "../components/SkillGroups.astro";
import EducationCard from "../components/EducationCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getRecentPosts } from "../lib/posts";
import { getSkills, getEducation } from "../lib/profile";

const [posts, skills, education] = await Promise.all([
  getRecentPosts(3),
  getSkills(),
  getEducation(),
]);

const [current] = education;
---

<BaseLayout title="Home">
  <Hero
    slot="hero"
    title="Aaron Brunswig"
    subtitle="Web developer · CS student at CU Boulder"
  >
    <p>
      I build websites and web apps, and I'm studying computer science to go
      deeper into backend systems. This site documents my course project.
    </p>

    <Fragment slot="actions">
      <a
        href="/about"
        class="rounded-md bg-on-inverse px-5 py-2.5 text-sm font-semibold text-ink hover:bg-on-inverse-muted"
      >
        About me
      </a>
      <a
        href="#contact"
        class="rounded-md border border-on-inverse-muted/50 px-5 py-2.5 text-sm font-semibold text-on-inverse hover:border-on-inverse-muted"
      >
        Contact
      </a>
    </Fragment>
  </Hero>
  <div class="flex flex-col gap-20">
    <section aria-labelledby="recent-posts-heading" class="flex flex-col gap-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="recent-posts-heading" class="text-3xl font-semibold">
            Recent Posts
          </h2>
          <p class="mt-2 text-muted">
            Weekly updates from my CSPB 3112 course project.
          </p>
        </div>
        <a href="/blog" class="text-sm font-semibold hover:underline">
          View all posts &rarr;
        </a>
      </div>

      {
        posts.length > 0 ? (
          <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <li>
                <PostCard {...post} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-muted">No posts yet. Check back soon.</p>
        )
      }
    </section>

    <div class="grid gap-12 lg:grid-cols-2 lg:gap-16">
      <section aria-labelledby="skills-heading">
        <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
          <h2 id="skills-heading" class="text-3xl font-semibold">Skills</h2>
          <a href="/about#skills" class="text-sm font-semibold hover:underline">
            Full list &rarr;
          </a>
        </div>
        <SkillGroups groups={skills} limit={4} />
      </section>

      <section aria-labelledby="education-heading">
        <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
          <h2 id="education-heading" class="text-3xl font-semibold">
            Education
          </h2>
          <a
            href="/about#education"
            class="text-sm font-semibold hover:underline"
          >
            More &rarr;
          </a>
        </div>
        {current && <EducationCard education={current.data} compact />}
      </section>
    </div>
  </div>
</BaseLayout>
