---
import Hero from "../components/Hero.astro";
import PostCard from "../components/PostCard.astro";
import QuickFacts from "../components/QuickFacts.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getRecentPosts } from "../lib/posts";
import { getFacts } from "../lib/profile";

const [posts, facts] = await Promise.all([getRecentPosts(6), getFacts()]);
---

<BaseLayout title="Home">
  <Hero
    slot="hero"
    title="Aaron Brunswig"
    subtitle="Web developer · CS student at CU Boulder"
  >
    <p>
      I build websites and web apps, and I'm studying computer science to go
      deeper into backend systems. This site documents my course project.
    </p>

    <Fragment slot="actions">
      <a
        href="/about"
        class="rounded-md bg-on-inverse px-5 py-2.5 text-sm font-semibold text-ink hover:bg-on-inverse-muted"
      >
        About me
      </a>
      <a
        href="#contact"
        class="rounded-md border border-on-inverse-muted/50 px-5 py-2.5 text-sm font-semibold text-on-inverse hover:border-on-inverse-muted"
      >
        Contact
      </a>
    </Fragment>
  </Hero>
  <div class="flex flex-col gap-24 py-8 lg:gap-32 lg:py-12">
    <section aria-labelledby="recent-posts-heading" class="flex flex-col gap-8">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="recent-posts-heading" class="text-3xl font-semibold">
            Recent Posts
          </h2>
          <p class="mt-2 text-muted">
            Weekly updates from my CSPB 3112 course project.
          </p>
        </div>
        <a href="/blog" class="text-sm font-semibold hover:underline">
          View all posts &rarr;
        </a>
      </div>

      {
        posts.length > 0 ? (
          <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
            {posts.map((post) => (
              <li>
                <PostCard {...post} />
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-muted">No posts yet. Check back soon.</p>
        )
      }
    </section>

    <section
      aria-labelledby="about-heading"
      class="grid gap-10 lg:grid-cols-[1fr_1fr] lg:gap-16"
    >
      <div>
        <h2 id="about-heading" class="text-3xl font-semibold">About me</h2>
        <p class="mt-4 max-w-prose text-lg text-muted">
          I've spent the last five years building and maintaining websites for
          clients, and I'm now studying computer science to move toward backend
          and systems work. Outside of web development, I enjoy photography,
          cooking, and hanging out with my dog Louie.
        </p>
        <a
          href="/about"
          class="mt-8 inline-flex rounded-md bg-inverse px-5 py-2.5 text-sm font-semibold text-on-inverse hover:bg-inverse/90"
        >
          More about me &rarr;
        </a>
      </div>

      <QuickFacts
        facts={facts}
        class="border-y border-line bg-white py-6 px-10 rounded-lg shadow-lg"
      />
    </section>
  </div>
</BaseLayout>
