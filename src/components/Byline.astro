---
import type Author from "../types/author";
import { Image } from "astro:assets";

interface Props {
  author: Author;
  date: Date;
  class?: string;
}

const { author, date, class: className } = Astro.props;

const dateString = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<div class:list={["flex items-center gap-x-4", className]}>
  {
    author.avatar ? (
      <Image
        height={40}
        width={40}
        densities={[2]}
        class="rounded-full object-cover h-10 w-10"
        src={author.avatar}
        alt={author.name}
      />
    ) : (
      <div class="h-10 w-10 rounded-full bg-neutral-600" />
    )
  }

  <div class="flex flex-col gap-y-0.5 text-sm">
    <span class="font-semibold">{author.name}</span>
    <time datetime={date.toISOString()}>{dateString}</time>
  </div>
</div>
