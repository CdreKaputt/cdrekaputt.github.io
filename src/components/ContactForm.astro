---
import { TURNSTILE_SITE_KEY } from "../consts";

const inputClass =
  "mt-2 block w-full rounded-md border border-line bg-page px-3 py-2 text-sm text-ink focus:border-ink focus:outline-none aria-invalid:border-red-600";
const errorClass = "mt-1.5 text-sm text-red-700 empty:hidden";
---

<form
  id="contact-form"
  method="post"
  class="flex flex-col gap-5 rounded-lg bg-white p-6 text-ink shadow-lg lg:p-10"
>
  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="contact-name" class="text-sm font-semibold">Name</label>
      <input
        id="contact-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        maxlength="100"
        class={inputClass}
      />
      <p data-error-for="name" class={errorClass}></p>
    </div>

    <div>
      <label for="contact-email" class="text-sm font-semibold">Email</label>
      <input
        id="contact-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        class={inputClass}
      />
      <p data-error-for="email" class={errorClass}></p>
    </div>
  </div>

  <div>
    <label for="contact-message" class="text-sm font-semibold">Message</label>
    <textarea
      id="contact-message"
      name="message"
      rows="6"
      minlength="10"
      maxlength="5000"
      class={inputClass}></textarea>
    <p data-error-for="message" class={errorClass}></p>
  </div>

  <div class="hidden" aria-hidden="true">
    <label for="contact-website">Website</label>
    <input
      id="contact-website"
      name="website"
      type="text"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <div>
    <div
      class="cf-turnstile"
      data-sitekey={TURNSTILE_SITE_KEY}
      data-appearance="interaction-only"
    >
    </div>
    <p data-error-for="cf-turnstile-response" class={errorClass}></p>
  </div>

  <div class="flex flex-wrap items-center gap-4">
    <button
      type="submit"
      class="rounded-md bg-inverse px-5 py-2.5 text-sm font-semibold text-on-inverse hover:bg-inverse/90 disabled:opacity-60"
    >
      Send message
    </button>
    <p data-status role="status" class="text-sm text-muted"></p>
  </div>
</form>

<script
  is:inline
  src="https://challenges.cloudflare.com/turnstile/v0/api.js"
  async
  defer></script>

<script>
  import { actions, isInputError } from "astro:actions";

  declare global {
    interface Window {
      turnstile?: { reset: () => void };
    }
  }

  const form = document.querySelector<HTMLFormElement>("#contact-form");

  if (form) {
    const status = form.querySelector<HTMLElement>("[data-status]")!;
    const button = form.querySelector<HTMLButtonElement>("[type=submit]")!;

    const setFieldError = (name: string, message = "") => {
      const field = form.elements.namedItem(name);
      const error = form.querySelector(`[data-error-for="${name}"]`);
      if (field instanceof HTMLElement) {
        if (message) field.setAttribute("aria-invalid", "true");
        else field.removeAttribute("aria-invalid");
      }
      if (error) error.textContent = message;
    };

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      form.querySelectorAll<HTMLElement>("[data-error-for]").forEach((el) => {
        setFieldError(el.dataset.errorFor!);
      });
      button.disabled = true;
      status.textContent = "Sending…";

      const { error } = await actions.contact(new FormData(form));
      window.turnstile?.reset();
      button.disabled = false;

      if (!error) {
        form.reset();
        status.textContent = "Thanks! Your message was sent.";
      } else if (isInputError(error)) {
        for (const [name, messages] of Object.entries(error.fields)) {
          setFieldError(name, messages?.[0]);
        }
        status.textContent = "Please fix the highlighted fields.";
      } else if (error.code === "FORBIDDEN") {
        status.textContent = error.message;
      } else {
        status.textContent =
          "Something went wrong. Please try again or email me directly.";
      }
    });
  }
</script>
