---
import { Image } from "astro:assets";

interface Props {
  title: string;
  subtitle?: string;
  image?: ImageMetadata;
  imageAlt?: string;
}

const { title, subtitle, image, imageAlt = title } = Astro.props;
---

<section class="bg-inverse text-on-inverse antialiased">
  <div
    class:list={[
      "mx-auto max-w-7xl px-4 py-16 lg:py-24",
      image && "grid items-center gap-10 lg:grid-cols-[1fr_auto] lg:gap-16",
    ]}
  >
    <div class="max-w-2xl">
      <h1 class="text-4xl font-bold text-balance lg:text-5xl">{title}</h1>

      {
        subtitle && (
          <p class="mt-3 text-lg font-medium text-on-inverse-muted">
            {subtitle}
          </p>
        )
      }

      {
        Astro.slots.has("default") && (
          <div class="mt-6 text-lg text-on-inverse-muted">
            <slot />
          </div>
        )
      }

      {
        Astro.slots.has("actions") && (
          <div class="mt-8 flex flex-wrap gap-3">
            <slot name="actions" />
          </div>
        )
      }
    </div>

    {
      image && (
        <Image
          src={image}
          alt={imageAlt}
          width={256}
          height={256}
          densities={[1, 2]}
          class="order-first size-40 rounded-full object-cover lg:order-0 lg:size-64"
        />
      )
    }
  </div>
</section>
