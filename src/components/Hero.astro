---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<section class="bg-inverse text-on-inverse antialiased">
  <div class="mx-auto max-w-7xl px-4 py-16">
    <h1 class="text-4xl font-bold">{title}</h1>
    {
      Astro.slots.has("default") && (
        <div class="mt-4 text-on-inverse-muted">
          <slot />
        </div>
      )
    }
  </div>
</section>
