---
interface Props {
	title: string;
}

const { title } = Astro.props;
---

<section class="bg-neutral-900 text-neutral-50">
	<div class="mx-auto max-w-3xl px-4 py-16">
		<h1 class="text-4xl font-bold">{title}</h1>
		{Astro.slots.has('default') && (
			<div class="mt-4 text-neutral-300">
				<slot />
			</div>
		)}
	</div>
</section>
