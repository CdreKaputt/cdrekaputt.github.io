---
import type Post from "../types/post";
import Tag from "./Tag.astro";
import Byline from "./Byline.astro";

interface Props extends Post {}

const { title, excerpt, date, href, author, category, tags } = Astro.props;
---

<article
  class="relative p-6 outline-1 outline-white rounded-lg shadow-lg bg-white flex flex-col gap-5 hover:outline-neutral-400 transition-colors duration-300 h-full"
>
  <div class="text-sm flex items-center gap-4">
    <div class="flex flex-wrap gap-x-2 gap-y-3">
      <Tag {...category} variant="category" />
      {tags.map((tag) => <Tag {...tag} />)}
    </div>
  </div>
  <div class="mb-3">
    <a
      href={href}
      class="after:absolute after:h-full after:w-full after:top-0 after:left-0"
    >
      <h3 class="mb-1 text-xl font-semibold">{title}</h3>
    </a>
    <p>{excerpt}</p>
  </div>
  <Byline author={author} date={date} class="mt-auto" />
</article>
