---
import type { CollectionEntry } from "astro:content";
import Tag from "./Tag.astro";

interface Props {
  education: CollectionEntry<"education">["data"];
  compact?: boolean;
}

const { education, compact = false } = Astro.props;
const { degree, school, period, coursework } = education;
---

<article class="rounded-lg border border-line bg-surface p-6">
  <p class="text-sm text-muted">{period}</p>
  <h3 class="mt-1 text-lg font-semibold">{degree}</h3>
  <p class="text-muted">{school}</p>

  {
    !compact && coursework.length > 0 && (
      <div class="mt-4">
        <h4 class="text-sm font-semibold">Relevant coursework</h4>
        <ul class="mt-2 flex flex-wrap gap-2">
          {coursework.map((course) => (
            <li>
              <Tag label={course} />
            </li>
          ))}
        </ul>
      </div>
    )
  }
</article>
